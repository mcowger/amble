{
  "name": "amble",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "paseo script start dev",
    "dev:server": "PORT=\"${PORT:-$(./scripts/port-allocator.sh)}\" bun --preload ./src/lib/paseo/relay-export-preload.ts --hot src/index.ts",
    "dev:stop": "paseo script stop dev",
    "stop": "paseo script stop dev",
    "init-worktree": "bun run scripts/init_worktree.ts",
    "build": "bun run build.ts",
    "compile": "bun run compile.ts",
    "deploy": "bun run deploy.ts",
    "install-daemon": "bun run install-daemon.ts",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "@getpaseo/client": "0.7.2",
    "@getpaseo/protocol": "0.7.2",
    "@getpaseo/relay": "0.7.2",
    "@radix-ui/react-collapsible": "^1.1.20",
    "@radix-ui/react-dialog": "^1.1.23",
    "@radix-ui/react-dropdown-menu": "^2.1.24",
    "@radix-ui/react-label": "^2.1.7",
    "@radix-ui/react-popover": "^1.1.23",
    "@radix-ui/react-progress": "^1.1.16",
    "@radix-ui/react-scroll-area": "^1.2.18",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.3",
    "@radix-ui/react-tabs": "^1.1.21",
    "@radix-ui/react-tooltip": "^1.2.16",
    "@react-aria/button": "^3.15.1",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/utils": "^3.34.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "bun-plugin-tailwind": "^0.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1",
    "prismjs": "^1.30.0",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.3.1",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/prismjs": "^1.26.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "agent-browser": "^0.36.0",
    "tailwindcss": "^4.1.11"
  },
  "peerDependencies": {
    "typescript": "^7"
  },
  "overrides": {
    "bun": "npm:empty-npm-package@1.0.0"
  },
  "trustedDependencies": [
    "agent-browser"
  ]
}
